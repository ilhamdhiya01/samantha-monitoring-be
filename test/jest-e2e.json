{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@nestjs/config$": "<rootDir>/stubs/nestjs-config.ts",
    "^@nestjs/schedule$": "<rootDir>/stubs/nestjs-schedule.ts",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
