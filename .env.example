NODE_ENV=development
LOG_LEVEL=info
PORT=3001

# docker compose up -d monitor-db (override publish ke 127.0.0.1:5443)
DATABASE_URL=postgresql://monitor:monitor@127.0.0.1:5443/monitor_db
POSTGRES_PASSWORD=monitor

FE_URL=http://localhost:3000

# Lokal: socket langsung. Produksi: DOCKER_HOST=tcp://docker-proxy:2375
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_HOST=
# Proxy aksi stop/start. Produksi: tcp://docker-action-proxy:2375 (diisi
# compose). Lokal kosong = lewat socket langsung.
DOCKER_ACTION_HOST=

# Produksi (di dalam container): /host/proc dan /host
HOST_PROC=/proc
HOST_ROOT=/
HOST_IP=

# Kosong = alert tidak dikirim, hanya disimpan & di-log
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stop/start container dari dashboard. Belum ada login: aktifkan hanya
# selama dashboard cuma bisa dibuka lewat SSH tunnel.
ACTIONS_ENABLED=false
# Compose project yang tidak boleh di-stop dari dashboard (monitor sendiri).
ACTIONS_PROTECTED_PROJECTS=samantha-monitoring-be,samantha-monitoring-fe

ALERT_DISK_PCT=80
ALERT_RESTART_COUNT=3
ALERT_RESTART_WINDOW_MIN=10
ALERT_ERROR_COUNT=10
ALERT_COOLDOWN_MIN=30
LOG_TAIL=500
LOG_SSE_MAX_LINES_PER_SEC=50
